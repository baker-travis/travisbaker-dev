{
  "name": "travis-baker-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npm run build && wrangler dev --config wrangler.jsonc",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern out --ignore-pattern .next --ignore-pattern dist --ignore-pattern .vinext"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.5",
    "typescript": "5.9.3",
    "wrangler": "4.135.0"
  },
  "type": "module"
}
