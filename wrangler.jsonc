{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "travisbaker-dev",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "travisbaker.dev",
      "custom_domain": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false
}
